generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PHARMACIST
  ADMIN
}

enum ScheduleClass {
  OTC
  H
  H1
  X
}

enum RxStatus {
  PENDING
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  PENDING_RX_VERIFICATION
  CONFIRMED
  PACKED
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id                    String         @id @default(cuid())
  name                  String
  phone                 String?        @unique
  email                 String         @unique
  password              String
  role                  Role           @default(CUSTOMER)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  addresses             Address[]
  orders                Order[]
  prescriptions         Prescription[] @relation("PatientPrescriptions")
  verifiedPrescriptions Prescription[] @relation("PharmacistVerifications")
  auditLogs             AuditLog[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  phone     String
  street    String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id            Int              @id @default(autoincrement())
  slug          String           @unique
  name          String
  salt          String
  company       String
  category      String
  pack          String
  price         Float
  mrp           Float
  discount      Int              @default(0)
  scheduleClass ScheduleClass    @default(OTC)
  requiresRx    Boolean          @default(false)
  hsnCode       String           @default("3004")
  gstRate       Float            @default(12.0)
  tag           String?
  icon          String?
  photo         String?
  imageUrl      String?
  description   String?
  dosage        String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  batches       InventoryBatch[]
  orderItems    OrderItem[]
}

model InventoryBatch {
  id            String      @id @default(cuid())
  productId     Int
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchNumber   String
  mfgDate       DateTime?
  expiryDate    DateTime
  quantity      Int
  mrp           Float
  purchasePrice Float?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
}

model Prescription {
  id                 String      @id @default(cuid())
  prescriptionNumber String      @unique
  userId             String
  user               User        @relation("PatientPrescriptions", fields: [userId], references: [id], onDelete: Cascade)
  fileUrl            String
  filePublicId       String?
  originalFilename   String
  mimeType           String
  patientName        String?
  patientAge         Int?
  doctorName         String?
  status             RxStatus    @default(PENDING)
  pharmacistNotes    String?
  rejectionReason    String?
  verifiedById       String?
  verifiedBy         User?       @relation("PharmacistVerifications", fields: [verifiedById], references: [id])
  verifiedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  orders             Order[]
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  addressId         String?
  address           Address?      @relation(fields: [addressId], references: [id])
  prescriptionId    String?
  prescription      Prescription? @relation(fields: [prescriptionId], references: [id])
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(COD)
  paymentStatus     PaymentStatus @default(PENDING)
  subtotal          Float
  discount          Float         @default(0)
  deliveryFee       Float         @default(0)
  taxAmount         Float         @default(0)
  totalAmount       Float
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  items             OrderItem[]
  invoice           Invoice?
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product         @relation(fields: [productId], references: [id])
  batchId    String?
  batch      InventoryBatch? @relation(fields: [batchId], references: [id])
  quantity   Int
  unitPrice  Float
  mrp        Float
  taxRate    Float
  taxAmount  Float
  totalPrice Float
}

model Invoice {
  id             String   @id @default(cuid())
  invoiceNumber  String   @unique
  orderId        String   @unique
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pharmacyGstin  String
  drugLicense20B String
  drugLicense21B String
  subtotal       Float
  cgstAmount     Float
  sgstAmount     Float
  igstAmount     Float
  totalAmount    Float
  pdfUrl         String?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}
